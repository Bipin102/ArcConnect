# Copy this file to .env and fill in your own values.
# NEVER commit .env — it's already gitignored.

ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# A testnet-only wallet's private key (no 0x prefix). Fund it with testnet
# USDC from https://faucet.circle.com (select Arc Testnet) before deploying —
# Arc uses USDC as gas, not ETH.
PRIVATE_KEY=
